# API existente de solicitudes y autenticación (visible al navegador).
VITE_API_BASE_URL=https://ticketera-backend-production-a834.up.railway.app

# Solo backend: mismo token que valida API_IMPORTAR_PERSONA. Nunca usar VITE_.
COOPYA_IMPORT_TOKEN=

# Vercel: URL HTTPS pública COMPLETA del endpoint ORDS. Pendiente de publicación.
COOPYA_ORDS_URL=

# LOCAL: en .env.development.local, para npm run dev dentro de la red/VPN:
# COOPYA_ORDS_URL=http://172.17.1.4:8080/ords/prestaprod/asistodo/personas

# Opcional, si el backend usa otra dirección para validar sesiones:
COOPYA_CANDIDATES_API_URL=

# COOPYA_ORACLE_CONFIG y COOPYA_PERSONAS_IMPORT_URL ya no se usan en la aceptación.

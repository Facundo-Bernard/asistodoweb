# Se configura en Vercel. Nunca uses VITE_ para este secreto.
COOPYA_IMPORT_TOKEN=

# Opcionales: si no se configuran, se usan VITE_API_BASE_URL y el endpoint de pruebas.
COOPYA_CANDIDATES_API_URL=
COOPYA_PERSONAS_IMPORT_URL=

# Una única configuración privada de Oracle. Nunca uses VITE_.
# connectString debe tener el formato host:puerto/servicio y ser accesible desde Vercel.
# personTypeId y personStatusId son IDs internos de Oracle, no Tipo=57 u Organismo=1146.
COOPYA_ORACLE_CONFIG={"user":"","password":"","connectString":"","personTypeId":"","personStatusId":"","providerId":"","provinceId":"","recordId":"","userId":""}

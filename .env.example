# API existente de solicitudes y autenticación (visible al navegador).
# Comprobar que este servicio responda antes de habilitar el panel.
VITE_API_BASE_URL=https://ticketera-backend-production-a834.up.railway.app

# Solo backend: mismo token que valida API_IMPORTAR_PERSONA. Nunca usar VITE_.
COOPYA_IMPORT_TOKEN=

# Vercel: URL HTTPS pública COMPLETA del endpoint ORDS. Pendiente de publicación.
COOPYA_ORDS_URL=

# LOCAL: en .env.development.local, para npm run dev dentro de la red/VPN:
# COOPYA_ORDS_URL=http://172.17.1.4:8080/ords/prestaprod/asistodo/personas

# Opcional, si el backend usa otra dirección para validar sesiones:
COOPYA_CANDIDATES_API_URL=

# Producción: elegir Oracle 11g real en lugar de la réplica Linux mediante ORDS.
# COOPYA_IMPORT_TARGET=oracle_prod
# Vercel: URL HTTPS pública del puente, que termina en /personas.
# COOPYA_ORACLE_BRIDGE_URL=https://puente.ejemplo.com/personas
# Oficina solamente: cuenta de escritura para el puente o el panel local.
# Extraer Instant Client del ZIP con scripts/prepareLocalOracleClient.ps1.
# NO cargar COOPYA_ORACLE_PROD_CONFIG en Vercel ni prefijarla con VITE_.
# COOPYA_ORACLE_PROD_CONFIG={"user":"PRESTAPROD","password":"CLAVE_PRIVADA","connectString":"172.17.1.3:1521/orcl"}

# COOPYA_ORACLE_CONFIG y COOPYA_PERSONAS_IMPORT_URL ya no se usan en la aceptación.

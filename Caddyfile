:8083 {
    root * /usr/share/caddy
    encode gzip zstd

    # Límite de tamaño en peticiones entrantes (mitigación de DoS / desbordamiento de memoria)
    request_body {
        max_size 10MB
    }

    # Bloqueo de archivos y directorios ocultos (.env, .git, etc.)
    @hidden {
        path */.*
        path .*
    }
    respond @hidden 404

    # Headers de seguridad recomendados
    header {
        # Ocultamiento del encabezado de identificación del servidor web
        -Server

        # Prevención de MIME-sniffing
        X-Content-Type-Options "nosniff"

        # Protección contra ataques de Clickjacking
        X-Frame-Options "DENY"

        # Control de fuga de información en la cabecera Referer
        Referrer-Policy "strict-origin-when-cross-origin"

        # Restricción de APIs sensibles del navegador
        Permissions-Policy "camera=(), microphone=(), geolocation=()"

        # Aislamiento de procesos y políticas de origen cruzado
        Cross-Origin-Opener-Policy "same-origin"
        Cross-Origin-Resource-Policy "same-origin"
    }

    # Fallback para Single Page Application (React Router)
    handle {
        try_files {path} /index.html
        file_server
    }
}

